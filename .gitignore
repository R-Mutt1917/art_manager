# ==========================================
# ENTORNO VIRTUAL Y DEPENDENCIAS
# ==========================================
venv/
env/
ENV/
*.egg-info/
dist/
build/

# ==========================================
# ARCHIVOS DE PYTHON Y CACHE
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ==========================================
# BASE DE DATOS (¡NUNCA SUBIR LA BD LOCAL!)
# ==========================================
*.db
*.sqlite
*.sqlite3

# ==========================================
# VARIABLES DE ENTORNO Y SECRETOS
# ==========================================
.env
.env.local
.env.*.local

# ==========================================
# ARCHIVOS SUBIDOS POR USUARIOS (No son código)
# ==========================================
app/uploads/*
!app/uploads/.gitkeep  # Esto mantiene la carpeta vacía en Git

# ==========================================
# EDITORES DE CÓDIGO Y SISTEMA OPERATIVO
# ==========================================
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ==========================================
# TESTS Y COBERTURA
# ==========================================
.pytest_cache/
.coverage
htmlcov/