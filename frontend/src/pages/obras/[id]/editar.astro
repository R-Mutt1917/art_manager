---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import ArtworkForm from '../../../components/ArtworkForm.tsx';
import RouteGuard from '../../../components/RouteGuard.tsx';

const { id } = Astro.params;
const obraId = Number(id);

// 1. Auth server-side: el token vive en la cookie, no en localStorage (que no existe en SSR)
const token = Astro.cookies.get('artmanager_token')?.value;

if (!token) {
  return Astro.redirect(`/login?redirect=/obras/${obraId}/editar`);
}

// 2. Fetch interno (red Docker) con el token de la cookie
const API_URL = import.meta.env.SSR 
  ? import.meta.env.API_URL 
  : import.meta.env.PUBLIC_API_URL;

let obra = null;
try {
  const res = await fetch(`${API_URL}/obras/${obraId}`, {
    headers: {
      'Authorization': `Bearer ${token}`,
      'Accept': 'application/json'
    }
  });

  if (res.status === 401 || res.status === 403) {
    return Astro.redirect('/login');
  }

  if (res.ok) {
    obra = await res.json();
  }
} catch (e) {
  console.error("Error cargando obra para edición:", e);
}

if (!obra) {
  return new Response(null, { status: 404 });
}

// 3. Resolver nombre de la técnica (endpoint público)
let tecnicaNombre = '';
if (obra.tecnica_id) {
  try {
    const resTec = await fetch(`${API_URL}/tecnicas/${obra.tecnica_id}`);
    if (resTec.ok) {
      const tec = await resTec.json();
      tecnicaNombre = tec?.nombre ?? '';
    }
  } catch (e) {
    console.error("Error cargando técnica:", e);
  }
}

// 4. Datos iniciales para el formulario (incluye statement de T7-1)
const initialData = {
  id: obra.id,
  titulo: obra.titulo,
  anio: obra.anio,
  dimensiones: obra.dimensiones,
  precio: obra.precio,
  notas: obra.notas,
  statement: obra.statement,
  estado: obra.estado,
  tecnica_nombre: tecnicaNombre,
  imagen_url: obra.imagen_url,
};
---

<Layout title={`Editar: ${obra.titulo}`} description={`Editar obra ${obra.titulo}`}>
  <RouteGuard client:only="react" />
  
  <nav class="mb-8" aria-label="Navegación de retorno">
    <a href={`/obras/${obra.id}`} class="inline-flex items-center gap-2 text-sm font-medium text-text-secondary hover:text-accent transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      Volver al detalle
    </a>
  </nav>

  <ArtworkForm client:load initialData={initialData} />
</Layout>