---
import Layout from '../../layouts/Layout.astro';
import { getTecnicas } from '../../services/api';
import RouteGuard from '../../components/RouteGuard.tsx';

export const prerender = false;

const tecnicas = await getTecnicas();
---

<Layout title="Gestión de Técnicas" description="Administra las técnicas artísticas">
  <RouteGuard client:only="react" />
  
  <div class="max-w-5xl mx-auto px-4 py-8">
    <div class="flex justify-between items-center mb-8">
      <div>
        <h1 class="font-serif text-3xl font-bold text-text-primary mb-2">Técnicas Registradas</h1>
        <p class="text-text-secondary">Gestiona las técnicas utilizadas en el catálogo de obras</p>
      </div>
      <a href="/" class="text-sm text-text-secondary hover:text-accent transition">← Volver al inicio</a>
    </div>

    {tecnicas.length === 0 ? (
      <div class="bg-white rounded-xl p-8 text-center border border-gray-200">
        <p class="text-text-secondary">No hay técnicas registradas aún.</p>
      </div>
    ) : (
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
        <table class="w-full text-left">
          <thead class="bg-gray-50 border-b border-gray-200">
            <tr>
              <th class="px-6 py-4 text-sm font-semibold text-text-secondary uppercase tracking-wider">Nombre</th>
              <th class="px-6 py-4 text-sm font-semibold text-text-secondary uppercase tracking-wider">Descripción</th>
              <th class="px-6 py-4 text-sm font-semibold text-text-secondary uppercase tracking-wider text-right">Acciones</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {tecnicas.map((tecnica) => (
              <tr class="hover:bg-gray-50 transition">
                <td class="px-6 py-4 text-text-primary font-medium">{tecnica.nombre}</td>
                <td class="px-6 py-4 text-text-secondary text-sm">{tecnica.descripcion || '—'}</td>
                <td class="px-6 py-4 text-right space-x-4">
                  <a href={`/tecnicas/${tecnica.id}/editar`} class="text-sm text-blue-600 hover:text-blue-800 font-medium transition">
                    Editar
                  </a>
                  <button
                    class="delete-btn text-sm text-red-600 hover:text-red-800 font-medium transition"
                    data-id={tecnica.id}
                    data-nombre={tecnica.nombre}
                  >
                    Eliminar
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

  <!-- 
    Script mejorado: usa httpClient para adjuntar el token automáticamente.
    type="module" es obligatorio para poder usar imports.
  -->
  <script type="module">
    import { http } from '../../services/httpClient.ts';

    document.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id;
        const nombre = btn.dataset.nombre;
        if (!id || !nombre) return;

        if (!confirm(`¿Eliminar "${nombre}"?\n\nNo se eliminará si tiene obras asociadas.`)) return;

        try {
          const data = await http.delete(`/tecnicas/${id}`);
          alert(data.mensaje);
          window.location.reload();
        } catch (error) {
          alert(error instanceof Error ? error.message : 'Error de conexión al eliminar.');
        }
      });
    });
  </script>
</Layout>