---
import Layout from '../layouts/Layout.astro';
import ArtworkCardPublic from '../components/ArtworkCardPublic.astro';

export const prerender = false;

const API_URL = import.meta.env.API_URL || 'http://localhost:8000';

let obras = [];
try {
  const response = await fetch(`${API_URL}/obras/publicas`);
  if (response.ok) {
    obras = await response.json();
  }
} catch (error) {
  console.error('Error:', error);
}

const tecnicasResponse = await fetch(`${API_URL}/tecnicas/`);
const tecnicas = tecnicasResponse.ok ? await tecnicasResponse.json() : [];
const tecnicasMap = new Map(tecnicas.map((t: any) => [t.id, t.nombre]));
---

<Layout title="Test Público" description="Prueba del catálogo público">
  <h1 class="text-3xl font-bold mb-8">Test: Catálogo Público</h1>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {obras.map((obra: any) => (
      <ArtworkCardPublic 
        obra={obra} 
        tecnicaNombre={String(obra.tecnica_id ? tecnicasMap.get(obra.tecnica_id) || 'Desconocida' : 'Desconocida')} 
    />
    ))}
  </div>
</Layout>