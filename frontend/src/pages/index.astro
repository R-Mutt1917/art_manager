---
import Layout from '../layouts/Layout.astro';
import { getObras } from '../services/api';

// Obtenemos los datos del backend ANTES de renderizar el HTML (Server-Side)
const obras = await getObras();
---

<Layout title="Catálogo" description="Colección de obras de arte">
  
  <section class="mb-12 text-center max-w-2xl mx-auto">
    <h1 class="font-serif text-4xl md:text-5xl font-bold mb-4">Catálogo de Obras</h1>
    <p class="text-text-secondary">Explora nuestra colección curada de obras de arte contemporáneo.</p>
  </section>

  {obras.length > 0 ? (
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {obras.map((obra) => (
        <li class="group bg-white p-6 rounded-lg shadow-sm border border-gray-100 hover:shadow-md hover:border-accent/30 transition-all duration-300">
          <h2 class="font-serif text-xl font-bold mb-2 group-hover:text-accent transition-colors">
            {obra.titulo}
          </h2>
          <p class="text-sm text-text-secondary mb-3">
            {obra.anio} • {obra.dimensiones}
          </p>
          <p class="text-lg font-semibold text-text-primary">
            {obra.precio ? `$${obra.precio.toLocaleString('es-AR')}` : 'Consultar'}
          </p>
        </li>
      ))}
    </ul>
  ) : (
    <div class="text-center py-20 bg-gray-50 rounded-lg border border-dashed border-gray-300" role="status">
      <p class="text-text-secondary text-lg">No hay obras disponibles en este momento. ¡Agrega algunas desde el backend!</p>
    </div>
  )}

</Layout>