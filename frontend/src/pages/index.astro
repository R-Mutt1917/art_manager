---
import Layout from '../layouts/Layout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import { getObras } from '../services/api';

const obras = await getObras();
---

<Layout title="Catálogo" description="Colección de obras de arte contemporáneo">
  
  <section class="mb-12 text-center max-w-2xl mx-auto">
    <h1 class="font-serif text-4xl md:text-5xl font-bold mb-4">Catálogo de Obras</h1>
    <p class="text-text-secondary">Explora nuestra colección curada de obras de arte contemporáneo.</p>
  </section>

  {obras.length > 0 ? (
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      {obras.map((obra) => (
        <li>
          <ArtworkCard obra={obra} />
        </li>
      ))}
    </ul>
  ) : (
    <div class="text-center py-20 bg-gray-50 rounded-lg border border-dashed border-gray-300" role="status">
      <p class="text-text-secondary text-lg">No hay obras disponibles en este momento.</p>
      <a href="http://localhost:8000/docs" target="_blank" class="text-accent hover:underline mt-2 inline-block">
        Agrega algunas desde el backend →
      </a>
    </div>
  )}

</Layout>