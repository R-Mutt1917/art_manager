---
import Layout from '../layouts/Layout.astro';
import ArtworkCard from '../components/ArtworkCard.astro';
import CatalogFilters from '../components/CatalogFilters.tsx';
import type { Obra } from '../services/api';

export const prerender = false;

// 1. Leer los filtros desde la URL (query params)
const url = new URL(Astro.request.url);
const queryParams = {
  tecnica: url.searchParams.get('tecnica'),
  estado: url.searchParams.get('estado'),
  precio_min: url.searchParams.get('precio_min'),
  precio_max: url.searchParams.get('precio_max'),
  busqueda: url.searchParams.get('busqueda'),
};

// 2. Construir la URL del backend con esos filtros
const API_URL = import.meta.env.API_URL || 'http://localhost:8000';
const params = new URLSearchParams();
Object.entries(queryParams).forEach(([key, value]) => {
  if (value) params.set(key, value);
});
const apiUrl = params.toString()
  ? `${API_URL}/obras/?${params.toString()}`
  : `${API_URL}/obras/`;

// 3. Fetch de obras ya filtradas (server-side)
let obras: Obra[] = [];
try {
  const response = await fetch(apiUrl);
  if (response.ok) {
    obras = await response.json();
  }
} catch (error) {
  console.error('Error al obtener obras:', error);
}

// 4. ¿Hay filtros activos? (para el mensaje de "sin resultados")
const hayFiltros = Object.values(queryParams).some((v) => v);
---

<Layout title="Catálogo" description="Colección de obras de arte contemporáneo">

  <section class="mb-8 text-center max-w-2xl mx-auto">
    <h1 class="font-serif text-4xl md:text-5xl font-bold mb-4">Catálogo de Obras</h1>
    <p class="text-text-secondary">Explora nuestra colección curada de obras de arte contemporáneo.</p>
  </section>

  <!-- Toolbar compacta de filtros (entre el título y las obras) -->
  <CatalogFilters client:load />

  {obras.length > 0 ? (
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
      {obras.map((obra: Obra) => (
        <li>
          <ArtworkCard obra={obra} />
        </li>
      ))}
    </ul>
  ) : (
    <div class="text-center py-20 bg-gray-50 rounded-lg border border-dashed border-gray-300" role="status">
      <p class="text-text-secondary text-lg">
        {hayFiltros
          ? 'No hay obras que coincidan con los filtros seleccionados.'
          : 'No hay obras disponibles en este momento.'}
      </p>
      <a href="/" class="text-accent hover:underline mt-2 inline-block">
        {hayFiltros ? 'Limpiar filtros' : 'Agrega algunas desde el backend →'}
      </a>
    </div>
  )}

</Layout>