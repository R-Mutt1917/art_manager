---
import Layout from '../layouts/Layout.astro';
import DashboardCharts from '../components/DashboardCharts.tsx';

export const prerender = false;
---

<Layout title="Dashboard" description="Métricas y estadísticas del catálogo">
  <div class="max-w-7xl mx-auto px-4 py-12">
    <header class="mb-8">
      <h1 class="font-serif text-4xl md:text-5xl font-bold text-text-primary mb-2">Dashboard</h1>
      <p class="text-text-secondary">Métricas y estadísticas de tu catálogo de obras</p>
    </header>

    <DashboardCharts client:load />
  </div>
</Layout>