---
import type { Artwork } from '../services/api';

interface Props {
  artwork: Artwork;
}

const { artwork } = Astro.props;

// URL de la imagen: usamos un placeholder elegante si no hay imagen
const imageUrl = artwork.imagen_url 
  ? `${import.meta.env.PUBLIC_API_URL}${artwork.imagen_url}` 
  : 'https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?auto=format&fit=crop&q=80&w=800';

// Formateo de precio
const precioFormateado = artwork.precio 
  ? new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' }).format(artwork.precio)
  : 'Consultar';
---

<article class="group flex flex-col bg-white rounded-lg overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 ease-in-out border border-gray-100">
  <!-- Enlace que envuelve todo para mejor UX (toda la tarjeta es clicable) -->
  <a href={`/obras/${artwork.id}`} class="flex flex-col flex-grow focus:outline-none focus-visible:ring-2 focus-visible:ring-accent">
    
    <!-- Contenedor de imagen con relación de aspecto fija para evitar saltos de layout (CLS) -->
    <figure class="relative aspect-[4/5] overflow-hidden bg-gray-100">
      <img 
        src={imageUrl} 
        alt={`Obra de arte titulada: ${artwork.titulo}`} 
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
      <!-- Badge de estado (solo visible si no es 'disponible') -->
      {artwork.estado !== 'disponible' && (
        <span class="absolute top-3 right-3 px-3 py-1 text-xs font-semibold uppercase tracking-wider bg-gray-900 text-white rounded-full">
          {artwork.estado}
        </span>
      )}
    </figure>

    <!-- Información de la obra -->
    <figcaption class="p-5 flex flex-col flex-grow">
      <h3 class="font-serif text-xl font-bold text-text-primary mb-1 group-hover:text-accent transition-colors">
        {artwork.titulo}
      </h3>
      
      <div class="flex items-center gap-2 text-sm text-text-secondary mb-3">
        <span>{artwork.anio}</span>
        <span aria-hidden="true">•</span>
        <span>{artwork.dimensiones}</span>
      </div>

      <div class="mt-auto pt-4 border-t border-gray-100 flex items-center justify-between">
        <span class="text-lg font-semibold text-text-primary">
          {precioFormateado}
        </span>
        <span class="text-sm font-medium text-accent group-hover:underline">
          Ver detalles →
        </span>
      </div>
    </figcaption>
  </a>
</article>