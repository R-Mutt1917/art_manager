---
// Tarjeta de obra para catálogo público con imagen borrosa.
// El blur CSS genera curiosidad y protege visualmente la obra.

interface Props {
  obra: {
    id: number;
    titulo: string;
    anio: number;
    estado: string;
    imagen_url: string | null;
  };
  tecnicaNombre?: string;
}

const { obra, tecnicaNombre = 'Técnica no especificada' } = Astro.props;

const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

// Traducir estado a texto legible
const estadoLegible = obra.estado === 'disponible' ? 'Disponible' 
  : obra.estado === 'vendida' ? 'Vendida' 
  : obra.estado === 'en_exposicion' ? 'En exposición' 
  : 'En préstamo';

// URL de la imagen (o null si no hay)
const imagenSrc = obra.imagen_url ? `${API_URL}${obra.imagen_url}` : null;
---

<a href="/login" class="group block bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-lg transition-shadow border border-gray-100">
  
  <!-- Imagen con blur CSS -->
  <figure class="aspect-[4/3] relative overflow-hidden bg-gray-100">
    {imagenSrc ? (
      <img
        src={imagenSrc}
        alt={obra.titulo}
        class="w-full h-full object-cover blur-md scale-110 opacity-70 group-hover:blur-sm group-hover:opacity-80 transition-all duration-500"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full bg-gradient-to-br from-gray-200 to-gray-300 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-16 h-16 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
    )}
    
    <!-- Overlay con mensaje -->
    <div class="absolute inset-0 flex items-center justify-center bg-black/10">
      <span class="text-xs text-white bg-black/40 px-3 py-1.5 rounded-full backdrop-blur-sm font-medium">
        Inicia sesión para ver la imagen completa
      </span>
    </div>
  </figure>

  <div class="p-5">
    <h3 class="font-serif text-lg font-bold text-text-primary mb-2 group-hover:text-accent transition-colors">
      {obra.titulo}
    </h3>
    <p class="text-sm text-text-secondary mb-3">{obra.anio}</p>
    <p class="text-xs text-text-secondary mb-2">Técnica: {tecnicaNombre}</p>
    <div class="flex items-center justify-between pt-3 border-t border-gray-100">
      <span class="text-xs font-medium px-2 py-1 rounded-full bg-gray-100 text-text-secondary">
        {estadoLegible}
      </span>
      <span class="text-xs text-accent font-medium">
        Ver detalles →
      </span>
    </div>
  </div>
</a>